<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.resumecraft.photos.PhotoMapper">
    <resultMap id="photoOriginal" type="com.resumecraft.photos.Photo">
        <constructor>
            <idArg
                column="id"
                javaType="java.util.UUID"
                typeHandler="com.resumecraft.common.UuidTypeHandler"
            />
            <arg
                column="user_id"
                javaType="java.util.UUID"
                typeHandler="com.resumecraft.common.UuidTypeHandler"
            />
            <arg column="content_type" javaType="java.lang.String" />
            <arg
                column="data"
                javaType="_byte[]"
                jdbcType="BINARY"
            />
            <arg column="created_at" javaType="java.time.OffsetDateTime" />
        </constructor>
    </resultMap>
    <!-- Session principals may use the account UUID or the unique login email. -->
    <select id="selectUserId" resultType="java.util.UUID">
        SELECT id
        FROM users
        WHERE id::text = #{identity}
            OR email = #{identity}
    </select>
    <insert id="insert">
        INSERT INTO photo (
            id, user_id, content_type, data, created_at
        )
        VALUES (
            #{id}, #{userId}, #{contentType}, #{data,jdbcType=BINARY}, #{createdAt}
        )
    </insert>
    <select id="findOwned" resultMap="photoOriginal">
        SELECT id, user_id, content_type, data, created_at
        FROM photo
        WHERE id = #{id}
            AND user_id = #{userId}
    </select>
</mapper>
