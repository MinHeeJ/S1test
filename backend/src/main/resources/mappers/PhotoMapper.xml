<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.resumecraft.photos.PhotoMapper">
    <resultMap id="photoResult" type="com.resumecraft.photos.PhotoRecord">
        <constructor>
            <idArg column="id" javaType="java.util.UUID" />
            <arg column="user_id" javaType="java.util.UUID" />
            <arg column="content_type" javaType="java.lang.String" />
            <arg column="data" javaType="[B" jdbcType="BINARY" />
        </constructor>
    </resultMap>
    <insert id="insert">
        INSERT INTO photo (id, user_id, content_type, data)
        VALUES (#{id}, #{userId}, #{contentType}, #{data,jdbcType=BINARY})
    </insert>
    <select id="findOwned" resultMap="photoResult">
        SELECT id, user_id, content_type, data
        FROM photo
        WHERE id = #{id}
            AND user_id = #{userId}
    </select>
</mapper>
