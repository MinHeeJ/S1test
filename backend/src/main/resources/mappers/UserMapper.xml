<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.resumecraft.common.persistence.UserMapper">
    <resultMap id="row" type="com.resumecraft.common.persistence.UserRow">
        <constructor>
            <idArg
                column="id"
                javaType="java.util.UUID"
                typeHandler="com.resumecraft.common.persistence.UuidTypeHandler"
            />
            <arg column="email" javaType="java.lang.String"/>
            <arg column="nickname" javaType="java.lang.String"/>
            <arg column="password_hash" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>
    <select id="findByEmail" resultMap="row">
        SELECT
            id,
            email,
            nickname,
            password_hash,
            created_at,
            updated_at
        FROM users
        WHERE email = #{email}
    </select>
    <select id="findById" resultMap="row">
        SELECT
            id,
            email,
            nickname,
            password_hash,
            created_at,
            updated_at
        FROM users
        WHERE id = #{id}
    </select>
    <insert id="insert">
        INSERT INTO users (
            id,
            email,
            nickname,
            password_hash,
            created_at,
            updated_at
        )
        VALUES (
            #{id},
            #{email},
            #{nickname},
            #{passwordHash},
            #{createdAt},
            #{updatedAt}
        )
    </insert>
</mapper>
