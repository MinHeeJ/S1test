<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.resumecraft.common.persistence.UserMapper">
    <resultMap id="row" type="com.resumecraft.common.persistence.UserRow">
        <constructor>
            <arg column="id" javaType="java.lang.Long"/>
            <arg column="email" javaType="java.lang.String"/>
            <arg column="nickname" javaType="java.lang.String"/>
            <arg column="password_hash" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.OffsetDateTime"/>
            <arg column="updated_at" javaType="java.time.OffsetDateTime"/>
        </constructor>
    </resultMap>
    <select id="findByEmail" resultMap="row">
        SELECT
            id,
            email,
            nickname,
            password_hash,
            created_at,
            updated_at
        FROM users
        WHERE email = #{email}
    </select>
    <select id="findById" resultMap="row">
        SELECT
            id,
            email,
            nickname,
            password_hash,
            created_at,
            updated_at
        FROM users
        WHERE id = #{id}
    </select>
    <select id="insert" resultType="java.lang.Long" affectData="true" flushCache="true">
        INSERT INTO users (email, nickname, password_hash)
        VALUES (#{email}, #{nickname}, #{passwordHash})
        RETURNING id
    </select>
</mapper>
